# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Optional — Instagram scraping (если нужен private scraping, лучше не использовать)
# IG_USERNAME=
# IG_PASSWORD=

# Optional — 2GIS API (НЕ рекомендуется, бесплатный ключ не даёт телефоны;
# мы парсим через Playwright. Оставь пустым для использования web scraping)
# TWOGIS_API_KEY=

# App settings
LOG_LEVEL=INFO
DATA_DIR=./data
